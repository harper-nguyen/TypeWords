# ============================================================
# TypeWords — Environment Variables
# ============================================================
# Copy file này thành .env.local để chạy local
# Trên Vercel: thêm các biến này vào Project Settings > Environment Variables
# ============================================================

# Gemini API Key — lấy tại https://aistudio.google.com/apikey
NUXT_PUBLIC_GEMINI_API_KEY=

# Supabase — lấy tại https://supabase.com (Project Settings > API)
# Dùng để sync data giữa các thiết bị
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# App origin (thay bằng URL Vercel của bạn sau khi deploy)
ORIGIN=https://your-app.vercel.app
